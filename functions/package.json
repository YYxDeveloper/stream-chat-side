{
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Functions for Stream Chat integration",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:android": "adb forward tcp:9222 localabstract:chrome_devtools_remote && playwright test --project=android-pixel-6-pro"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "stream-chat": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.0.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.0.0",
    "playwright": "^1.59.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
